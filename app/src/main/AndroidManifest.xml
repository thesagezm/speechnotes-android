<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET is scoped to model downloads only: the app's speech, notes
         and books all run fully offline. Downloads are user-initiated from
         Settings and land in app-private storage. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lock-screen controls + background audio: playback runs inside a
         mediaPlayback foreground service (NowPlayingCenter parity). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- BookDrop speaks the LocalSend v2.2 protocol: plain HTTP on the LAN
         by design (no TLS between trusted peers). The receiver's raw sockets
         bypass the platform cleartext policy; the sender's OkHttp needs the
         usesCleartextTraffic flag below. Migration queued: move the sender
         to raw sockets and drop this flag (see QUEUE.md). -->
    <!-- Platform backup / device transfer are OFF (backup_rules.xml +
         data_extraction_rules.xml): the notes live in app-private storage
         and are either plaintext (vault off — must not leave the device)
         or sealed with a device-bound key (vault on — unrestorable
         elsewhere). The sanctioned backup is Settings -> Backup (.jex). -->
    <application
        android:name=".SpeechnotesApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Speechnotes"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Speechnotes"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Import text via speechnotes://import?text=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="speechnotes" android:host="import" />
            </intent-filter>

            <!-- Open .txt/.md/.pdf/.epub/.m4b/.mp3 files and office documents
                 into the app (office formats normalize to EPUB on import). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="audio/mp4" />
                <data android:mimeType="audio/mpeg" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/vnd.oasis.opendocument.presentation" />
                <data android:mimeType="application/msword" />
            </intent-filter>
        </activity>

        <!-- Media playback foreground service: owns the MediaSession that
             drives the lock-screen surface and keeps TTS and audiobook audio
             alive while the app is backgrounded. -->
        <service
            android:name=".playback.SpeechPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Shares exports and landed BookDrop files with other apps. The
             paths config was present but the provider was never declared, so
             FileProvider.getUriForFile threw for every share — a file the
             receiving app has no permission to read. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
